#!/usr/bin/env php
<?php
/**
 * Looks up one business on Google and shows its place id and the reviews
 * Google returns now, with their ids. Writes nothing: the site fetches the
 * reviews itself (README, "Finding the place id").
 *
 *   GOOGLE_PLACES_API_KEY=… KOE_QUERY="Name, Street 1, 12345 Town" vendor/bin/koe-fetch
 *   php site/plugins/koe/bin/koe-fetch --query="…" --language=de
 *
 * Settings and exit codes are described in src/Fetch.php.
 */
if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

// No Kirby here: the class map is loaded directly (the same map as index.php).
$root = dirname(__DIR__);
$classes = require $root . '/autoload.php';
spl_autoload_register(static function (string $class) use ($classes, $root): void {
	$file = $classes[strtolower($class)] ?? null;
	if ($file !== null) {
		require_once $root . '/' . $file;
	}
});

exit(Sayamaapps\Koe\Fetch::run(getenv(), $argv, null, STDOUT, STDERR));
