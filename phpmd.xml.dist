<?xml version="1.0"?>
<ruleset name="Koe"
	xmlns="http://pmd.sf.net/ruleset/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
	xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
	<description>PHP Mess Detector rules for Koe. PMD's default thresholds; every exclusion has its reason here. Test classes suppress single rules in their docblocks.</description>

	<rule ref="rulesets/cleancode.xml">
		<!-- Options, I18n, Fetch and the legacy functions are static helpers, as Kirby's own code is. -->
		<exclude name="StaticAccess" />
	</rule>

	<rule ref="rulesets/codesize.xml" />

	<rule ref="rulesets/design.xml" />

	<rule ref="rulesets/naming.xml">
		<!-- Short names for the comparator arguments ($a, $b), the regex matches ($m) and the test results ($r). -->
		<exclude name="ShortVariable" />
		<!-- I18n::t() is the translation shorthand, as Kirby's t() is. -->
		<exclude name="ShortMethodName" />
	</rule>

	<rule ref="rulesets/unusedcode.xml" />
</ruleset>
